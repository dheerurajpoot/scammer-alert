rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /scammerReports/{reportId} {
      // Anyone can read reports
      allow read: if true;
      
      // Anyone can create a new report
      // Must set status to 'pending' and include at least one contact identifier
      allow create: if 
        request.resource.data.status == 'pending' &&
        (
          (request.resource.data.keys().hasAll(['phoneNumber']) && request.resource.data.phoneNumber != "") ||
          (request.resource.data.keys().hasAll(['facebookId']) && request.resource.data.facebookId != "") ||
          (request.resource.data.keys().hasAll(['instagramId']) && request.resource.data.instagramId != "") ||
          (request.resource.data.keys().hasAll(['otherId']) && request.resource.data.otherId != "")
        );
      
      // Only admins can update or delete
      allow update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      // Allow a user to read their own admin status
      allow read: if request.auth != null && request.auth.uid == adminId;
      
      // Only existing admins can create/update other admin records
      allow write: if isAdmin();
    }
  }
}
