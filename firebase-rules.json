{
  "rules": {
    "scammerReports": {
      ".read": "true",
      "$reportId": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).exists())",
        
        ".validate": "newData.hasChildren(['scamType', 'description', 'status', 'createdAt', 'updatedAt']) && (newData.child('phoneNumber').exists() || newData.child('facebookId').exists() || newData.child('instagramId').exists() || newData.child('otherId').exists()) && (newData.child('status').val() === 'pending' || (auth != null && root.child('admins').child(auth.uid).exists()))"
      }
    },
    "admins": {
      ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".validate": "newData.hasChildren(['email', 'role', 'createdAt']) && newData.child('role').val() === 'admin'"
      }
    }
  }
}
